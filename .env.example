# Copy to .env for local dev. NEVER commit .env. In Vercel, set these as Environment Variables.
LLM_PROVIDERS=gemini,groq,openai,ollama   # fallback order; providers without a key/URL are skipped
LLM_TIMEOUT_MS=20000
GROQ_API_KEY=               # secret - hosting env only
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=            # local/self-hosted only, e.g. http://localhost:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=             # secret - hosting env only
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_EFFORT=low
OPENAI_API_KEY=             # secret - hosting env only 
OPENAI_MODEL=gpt-4.1-mini
SUPABASE_URL=https://conpvzybjevzcxmrplhg.supabase.co
SUPABASE_ANON_KEY=         # publishable/anon key (safe for browser)
BEBE_RPC_TOKEN=            # secret (random 48+ chars) - hosting env only; its SHA-256 goes in bebe_server_config
MAX_OUTPUT_TOKENS=400
MAX_MESSAGE_CHARS=2000
MAX_HISTORY_MESSAGES=12
RATE_LIMIT_IP_PER_MINUTE=10
RATE_LIMIT_IP_PER_HOUR=60
RATE_LIMIT_USER_PER_MINUTE=15
RATE_LIMIT_USER_PER_HOUR=120
DAILY_REQUEST_LIMIT=500
DAILY_TOKEN_BUDGET=300000
MONTHLY_REQUEST_LIMIT=10000
MONTHLY_TOKEN_BUDGET=5000000
ALERT_WEBHOOK_URL=         # optional Slack/Discord-style webhook for 50/80/100% alerts
PRODUCT_REFRESH_MINUTES=60
IP_HASH_SALT=change-me
EMBED_ORIGINS=https://beberaygardon.myshopify.com  # sites allowed to frame the chat widget
OWNER_EMAIL=               # comma-separated owner emails allowed into /admin (or use owner_emails table)
SHOPIFY_ADMIN_TOKEN=       # secret, read-only Admin API token (admin only; leave unset until provided)
SHOPIFY_STORE_DOMAIN=beberaygardon.myshopify.com
